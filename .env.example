# Google Gemini API Configuration (Obtén tu API Key gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Database Configuration
# Por defecto usa SQLite local pre-cargado para pruebas inmediatas.
# Para producción o Docker con PostgreSQL, descomenta la línea de abajo:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_ops_db
DATABASE_URL=sqlite:///./enterprise_ops.db

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
